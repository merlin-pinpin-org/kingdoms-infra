# Production environment: secrets live on the host or in GitHub secrets
# (kingdoms-infra#2); this template documents the required variables.

# Discord bot credentials (required)
DISCORD_TOKEN=your_discord_bot_token_here

# MongoDB (overridden by compose to reach the kingdoms-mongo service)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kingdoms

# Redis (overridden by compose to reach the kingdoms-redis service)
REDIS_URI=redis://localhost:6379

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Full bot image reference, pinned on purpose (required, prod only):
# deployments and rollbacks move the tag explicitly, never implicitly.
KINGDOMS_BOT_IMAGE=ghcr.io/merlin-pinpin/kingdoms-services:v0.0.0
