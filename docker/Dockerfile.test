# Test image: same base as the production image with dev tools installed.

FROM python:3.12-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
RUN uv sync --no-install-project

COPY src/ ./src/
COPY tests/ ./tests/
RUN uv sync

CMD ["uv", "run", "pytest"]
